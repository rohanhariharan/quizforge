{
  "name": "quizforge",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Turn any document into a timed, LaTeX-native quiz \u2014 Tauri + MathQuill + KaTeX.",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "start": "tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dist": "tauri build",
    "dist:mac": "tauri build --target aarch64-apple-darwin",
    "icon": "node scripts/make-icon.mjs && tauri icon build/icon.png",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.5.1",
    "@tauri-apps/plugin-store": "^2.5.0",
    "jquery": "^3.7.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "mammoth": "^1.10.0",
    "mathquill": "0.10.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "vite": "^8.3.5"
  },
  "author": "Rohan Hariharan",
  "license": "MIT"
}
